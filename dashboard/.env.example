# Copy this file to .env and fill in real values for local development.
#
# VITE_API_BASE_URL — where the FastAPI serving app is running.
#   Local dev against `uvicorn serving.app:app`:        http://localhost:8000
#   Deployed (once the Kubernetes Service is reachable): https://your-domain/api
#
# VITE_API_KEY — must match one of the keys in STOCK_API_KEYS on the backend.
#   WARNING: this gets bundled into the built JS and is visible to anyone who
#   opens the browser's dev tools. Fine for local development against your
#   own backend. For a real public deployment, put a thin server-side proxy
#   in front that holds the real key, rather than shipping it to the browser.

VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=dev-key-12345
